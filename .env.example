# =============================================================================
# LA Chat — example environment configuration
# Copy to .env (root) and apps/api/.env and apps/web/.env as needed.
# NEVER commit real secrets. This file is for documentation only.
# =============================================================================

# ----- Core -----
NODE_ENV=development
APP_NAME=LA Chat
SCHOOL_NAME=Light Academy Secondary School
SCHOOL_MOTTO=A Different Approach to Education

# ----- Database (PostgreSQL) -----
# In docker-compose, the host is "db". On the school server, "127.0.0.1".
DATABASE_URL=postgresql://la_chat:change_me_in_prod@127.0.0.1:5432/la_chat?schema=public
POSTGRES_USER=la_chat
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=la_chat

# ----- Redis -----
REDIS_URL=redis://127.0.0.1:6379

# ----- Object storage (MinIO, S3-compatible) -----
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=la_chat_minio
S3_SECRET_ACCESS_KEY=change_me_in_prod
S3_BUCKET=la-chat-media
S3_FORCE_PATH_STYLE=true

# ----- Auth / JWT -----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_48_byte_random_string
JWT_REFRESH_SECRET=replace_with_different_48_byte_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ----- API server -----
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000

# ----- Push notifications (Phase 4) -----
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=

# ----- Cloud backup (Phase 6) -----
CLOUD_BACKUP_BUCKET=
CLOUD_BACKUP_ACCESS_KEY_ID=
CLOUD_BACKUP_SECRET_ACCESS_KEY=
CLOUD_BACKUP_ENCRYPTION_KEY_PATH=/etc/la-chat/backup.key

# ----- Monitoring -----
LOG_LEVEL=info
SENTRY_DSN=
